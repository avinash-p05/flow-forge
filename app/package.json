{
  "name": "flowforge",
  "version": "2.0.0",
  "description": "Distributed workflow engine: API + queue-based workers on PostgreSQL, Redis and AWS SQS",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "tsx --test test/*.test.ts",
    "test:e2e": "tsx scripts/e2e-test.ts",
    "test:load": "tsx scripts/load-test.ts",
    "test:failure": "tsx scripts/failure-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1146.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
