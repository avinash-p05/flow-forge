{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.ts",
  "scripts": {
    "start": "node --loader ts-node/esm src/server.ts",
    "worker": "node --loader ts-node/esm src/worker.ts",
    "test": "node --loader ts-node/esm --test test/handlers.test.ts",
    "dev": "nodemon --exec \"node --loader ts-node/esm\" src/server.ts",
    "db:up": "docker compose -f ../docker-compose.yml up -d postgres redis",
    "db:down": "docker compose -f ../docker-compose.yml down",
    "smoke": "node scripts/smoke-test.mjs"
    ,"typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "benchmark:generate": "node --loader ts-node/esm scripts/benchmark/generate-workflows.ts",
    "benchmark:run": "node --loader ts-node/esm scripts/benchmark/run-benchmark.ts",
    "benchmark:collect": "node --loader ts-node/esm scripts/benchmark/collect-results.ts",
    "benchmark:report": "node --loader ts-node/esm scripts/benchmark/report.ts",
    "failure:test": "node --loader ts-node/esm failure-injection.ts"
    ,"test:idempotency": "node scripts/idempotency-test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1146.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
