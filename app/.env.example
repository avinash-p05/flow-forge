# Template for local development:  cp .env.example .env.local
# Used only by `npm run dev` / `npm run dev:worker` on your machine, with
# `docker compose up -d postgres redis elasticmq` providing the dependencies.
#
# Docker Compose sets its own variables in docker-compose.yml, and production (ECS) gets them
# from the task definition + AWS Secrets Manager, so there is no .env file for production.
PORT=3000
DATABASE_URL=postgresql://flowforge:flowforge@127.0.0.1:5433/flowforge
DATABASE_POOL_SIZE=20
REDIS_URL=redis://127.0.0.1:6379
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_TOKEN_TTL_SECONDS=3600

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# Leave SQS_QUEUE_URL empty to run without a queue (workers poll PostgreSQL only).
SQS_QUEUE_URL=http://127.0.0.1:9324/000000000000/flowforge-executions
AWS_ENDPOINT_URL=http://127.0.0.1:9324
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

WORKER_CONCURRENCY=10
EXECUTION_LEASE_MS=30000
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_DELAY_MS=1000
JOB_TIMEOUT_MS=30000
