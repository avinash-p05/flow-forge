PORT=3000
DATABASE_URL=postgresql://flowforge:flowforge@127.0.0.1:5433/flowforge
DATABASE_POOL_SIZE=10
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_TOKEN_ISSUER=flowforge-server
AUTH_TOKEN_AUDIENCE=flowforge-client
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_DELAY_MS=1000
JOB_TIMEOUT_MS=30000
WORKER_POLL_INTERVAL_MS=1000
REDIS_URL=redis://localhost:6379
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=30
WORKFLOW_CACHE_TTL_SECONDS=300
AWS_REGION=us-east-1
SQS_QUEUE_URL=
SQS_VISIBILITY_TIMEOUT_SECONDS=60
SQS_WAIT_TIME_SECONDS=20
SQS_MAX_MESSAGES=10
# Optional for LocalStack or another AWS-compatible local endpoint.
AWS_ENDPOINT_URL=
