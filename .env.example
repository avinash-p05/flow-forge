# FlowForge configuration template.  cp .env.example .env
# The ONE env file (.env, git-ignored) is read by both npm scripts (app/src/infra/config.ts)
# and docker compose. Inside Docker, DATABASE_URL / REDIS_URL / AWS_ENDPOINT_URL are rewritten
# to container hostnames automatically, so the same file works for both.
# Production (ECS) reads no file: values come from the task definition + Secrets Manager.

PORT=3000
DATABASE_URL=postgresql://flowforge:flowforge@127.0.0.1:5433/flowforge
DATABASE_POOL_SIZE=20
REDIS_URL=redis://127.0.0.1:6379
AUTH_TOKEN_SECRET=local-dev-secret-change-me-0123456789abcdef
AUTH_TOKEN_TTL_SECONDS=3600

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# SQS. Default below = local ElasticMQ (started by docker compose).
# Real AWS SQS instead: SQS_QUEUE_URL=https://sqs.<region>.amazonaws.com/<account-id>/flowforge-executions,
#   AWS_REGION=<the queue's region>, AWS_ENDPOINT_URL= (empty), and your access key + secret.
# Leave SQS_QUEUE_URL empty to run without a queue (workers poll PostgreSQL only).
SQS_QUEUE_URL=http://127.0.0.1:9324/000000000000/flowforge-executions
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://127.0.0.1:9324
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

WORKER_CONCURRENCY=10
EXECUTION_LEASE_MS=30000
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_DELAY_MS=1000
JOB_TIMEOUT_MS=30000
