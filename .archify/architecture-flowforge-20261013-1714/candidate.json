  "cards": [
    {
      "dot": "cyan",
      "title": "Control plane",
      "items": [
        "Express routes expose auth, workflow, execution, and health operations",
        "Bearer JWT middleware protects workflow and execution APIs"
      ]
    },
    {
      "dot": "emerald",
      "title": "Durable execution",
      "items": [
        "PostgreSQL remains the source of truth for executions and jobs",
        "Workers claim leases, retry jobs, and settle terminal execution state"
      ]
    },
    {
      "dot": "amber",
      "title": "Resilience",
      "items": [
        "SQS is optional; workers fall back to PostgreSQL polling",
        "Redis is optional and used for rate-limit counters",
        "Queue redelivery and database sweeping recover lost work"
      ]
    },
    {
      "dot": "rose",
      "title": "Dead-letter queues",
      "items": [
        "Jobs that exhaust retries (exponential backoff + jitter) land in dead_letter_jobs and can be replayed via the API",
        "Messages that fail 5 receives move to the SQS dead-letter queue (redrive policy)"
      ]
    },
    {
      "dot": "violet",
      "title": "Load test results (AWS SQS)",
      "items": [
        "2,000 executions × 5-step DAG = 10,000 jobs: 10,000 / 10,000 completed via real AWS SQS",
        "50 live and 50 busy workers at peak (5 containers × 10 slots)",
        "~700 jobs/s · job p95 60 ms · execution end-to-end p95 651 ms, p99 768 ms"
      ]
    },
    {
      "dot": "orange",
      "title": "Failure-injection results (AWS SQS, 3 runs)",
      "items": [
        "12,000 jobs, 30% of attempts fail on purpose, 2 of 5 worker containers SIGKILLed twice per run",
        "99.0% of affected jobs recovered (3,556 / 3,592; runs 98.68 · 99.00 · 99.32%); 72 / 72 crash-lost jobs recovered",
        "0 jobs committed twice; 98.8% of executions succeeded, the rest dead-lettered"
      ]
    }
  ]
