# Run the local Docker stack against a REAL AWS SQS queue instead of ElasticMQ.
#   cp aws-sqs.env.example aws-sqs.env        (aws-sqs.env is git-ignored; never commit keys)
#   docker compose --env-file aws-sqs.env up -d --build --scale worker=2
#
# Postgres and Redis still run locally in Docker; only the queue is on AWS.
# The IAM user behind these keys needs sqs:SendMessage, ReceiveMessage, DeleteMessage,
# ChangeMessageVisibility and GetQueueAttributes on the queue.

SQS_QUEUE_URL=https://sqs.<region>.amazonaws.com/<account-id>/flowforge-executions
# Must be the queue's region, otherwise every SQS call fails with a signature error.
SQS_REGION=<region>
# Empty = talk to the real AWS endpoint instead of ElasticMQ.
SQS_ENDPOINT_URL=

SQS_ACCESS_KEY_ID=<your-access-key-id>
SQS_SECRET_ACCESS_KEY=<your-secret-access-key>
# Only needed for temporary credentials (SSO / assumed role):
SQS_SESSION_TOKEN=
