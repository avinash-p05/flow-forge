{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConsumeExecutionQueue",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:ChangeMessageVisibility",
        "sqs:GetQueueAttributes"
      ],
      "Resource": "arn:aws:sqs:<region>:<account-id>:flowforge-executions"
    }
  ]
}
