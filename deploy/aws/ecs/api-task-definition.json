{
  "family": "flowforge-api",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::<account-id>:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::<account-id>:role/flowforge-api-task-role",
  "containerDefinitions": [
    {
      "name": "flowforge-api",
      "image": "replaced-by-ci",
      "essential": true,
      "command": ["node", "dist/server.js"],
      "portMappings": [{ "containerPort": 3000, "protocol": "tcp" }],
      "environment": [
        { "name": "PORT", "value": "3000" },
        { "name": "AWS_REGION", "value": "<region>" },
        { "name": "SQS_QUEUE_URL", "value": "https://sqs.<region>.amazonaws.com/<account-id>/flowforge-executions" },
        { "name": "RATE_LIMIT_MAX_REQUESTS", "value": "100" }
      ],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "<secrets-manager-arn>:DATABASE_URL::" },
        { "name": "REDIS_URL", "valueFrom": "<secrets-manager-arn>:REDIS_URL::" },
        { "name": "AUTH_TOKEN_SECRET", "valueFrom": "<secrets-manager-arn>:AUTH_TOKEN_SECRET::" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -q -O - http://localhost:3000/health || exit 1"],
        "interval": 15,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 20
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/flowforge",
          "awslogs-region": "<region>",
          "awslogs-stream-prefix": "api"
        }
      }
    }
  ]
}
